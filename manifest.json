{
  "manifest_version": 3,
  "name": "WebCode Sonification Engine",
  "version": "0.4.1",
  "description": "Turns webpage structure into reproducible generative music, drivable by scroll or DOM changes. Local-only; nothing uploaded.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebCode Sonification Engine"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
